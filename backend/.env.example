# Database Configuration (PostgreSQL / Supabase or SQLite fallback)
# For Supabase: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# For Local SQLite: sqlite:///./sales_dashboard.db
DATABASE_URL=sqlite:///./sales_dashboard.db

# JWT Authentication
JWT_SECRET=super-secret-jwt-key-for-cse4104-dashboard-development-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Provider Configuration ('gemini', 'openai', 'deepseek', or 'grounded')
# gemini  → Google AI Studio key (free tier, 1500 req/day): aistudio.google.com
# deepseek → DeepSeek API key: platform.deepseek.com
# openai  → OpenAI API key: platform.openai.com
# grounded → No LLM; uses offline rule-based engine (no key needed)
AI_PROVIDER=grounded
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# CORS Settings (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
